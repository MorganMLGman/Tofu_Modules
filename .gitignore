# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used for local configurations
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore lock files
.terraform.lock.hcl

# Ignore local sensitive variables
*.auto.tfvars
*.auto.tfvars.json

# Ignore log files
*.log

# Ignore IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# Ignore Bitwarden files
.bitwarden/

.claude/