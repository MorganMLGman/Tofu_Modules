# Copy to <consumer repo>/.docker-workspace.env and fill in. Read by scripts/new_docker_workspace.sh.
STATE_PROFILE=terraform-scaleway
STATE_BUCKET=opentofu-state
STATE_REGION=pl-waw
STATE_ENDPOINT=https://s3.pl-waw.scw.cloud
# State keys are <STATE_PREFIX>/terraform.tfstate (LXC layer) and <STATE_PREFIX>/<name>_docker/terraform.tfstate
STATE_PREFIX=skierki
SCW_REGION=pl-waw
APP_SECRET_ID=00000000-0000-0000-0000-000000000000
CLOUDFLARE_SECRET_ID=00000000-0000-0000-0000-000000000000
CF_DOMAIN=example.com
# Key inside the Cloudflare secret that holds the API token
CF_API_TOKEN_KEY=cloudflare_api_token
